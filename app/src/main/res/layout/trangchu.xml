<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/avatar"
                android:background="@drawable/circle_bg"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi, StrBerryAw!"
                android:textStyle="bold"
                android:padding="8dp"
                android:background="@drawable/rounded_bg_green"
                android:textColor="@android:color/black" />

            <ImageView
                android:layout_width="92dp"
                android:layout_height="24dp"
                android:layout_marginEnd="16dp"
                android:src="@drawable/ic_search" />

            <ImageView
                android:layout_width="105dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="24dp"
            android:weightSum="3">

            <LinearLayout
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_star"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
                <TextView android:text="Rate" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_like"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
                <TextView android:text="Like" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/ic_view"
                    android:layout_width="48dp"
                    android:layout_height="48dp" />
                <TextView android:text="View" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hot Stories -->
        <TextView
            android:text="Hot Stories 🔥"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Lặp lại cho từng sách -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/truyenbacho" />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/truyenvonguyengiap" />
                <!-- Thêm tiếp ảnh sách -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Newly Updated Story -->
        <TextView
            android:text="NEWLY UPDATED STORY"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <!-- Lặp ảnh sách mới cập nhật -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/truyenkimdong" />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="150dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/truyenvothisau" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bottom Button -->
        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:src="@drawable/circle_background" />
    </LinearLayout>
</ScrollView>
